     wp_flags = cpu_watchpoint_address_matches(cpu, vaddr_page,
                                               TARGET_PAGE_SIZE);
+    /*
+     * Unicorn (page-scoped memory hooks): only a page that a READ or WRITE
+     * memory hook covers takes the slow path, flagged here the way QEMU
+     * flags a watchpoint (cpu_check_watchpoint is empty in Unicorn, so the
+     * flag only forces load_helper/store_helper, where the hooks run).
+     * Every other page keeps the inline fast path; see tcg_uc_has_hookmem.
+     */
+    wp_flags |= uc_mem_hook_page_flags(cpu->uc, paddr_page, TARGET_PAGE_SIZE);
 

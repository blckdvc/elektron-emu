diff --git a/qemu/include/exec/exec-all.h b/qemu/include/exec/exec-all.h
index 68c6567..2f280eb 100644
--- a/qemu/include/exec/exec-all.h
+++ b/qemu/include/exec/exec-all.h
@@ -477,6 +477,37 @@ address_space_translate_for_iotlb(CPUState *cpu, int asidx, hwaddr addr,
 hwaddr memory_region_section_get_iotlb(CPUState *cpu,
                                        MemoryRegionSection *section);
 
+/* Unicorn: BP_MEM_READ / BP_MEM_WRITE for a page that a READ(_AFTER) /
+   WRITE memory hook overlaps (a hook with begin > end covers everything). */
+static inline int _uc_hook_page_overlap(struct list_item *cur, hwaddr lo,
+                                        hwaddr hi)
+{
+    while (cur != NULL) {
+        struct hook *h = (struct hook *)cur->data;
+        if (!h->to_delete &&
+            (h->begin > h->end || (h->begin <= hi && h->end >= lo))) {
+            return 1;
+        }
+        cur = cur->next;
+    }
+    return 0;
+}
+
+static inline int uc_mem_hook_page_flags(struct uc_struct *uc, hwaddr page,
+                                         hwaddr size)
+{
+    int flags = 0;
+    hwaddr hi = page + size - 1;
+    if (_uc_hook_page_overlap(uc->hook[UC_HOOK_MEM_READ_IDX].head, page, hi) ||
+        _uc_hook_page_overlap(uc->hook[UC_HOOK_MEM_READ_AFTER_IDX].head, page, hi)) {
+        flags |= BP_MEM_READ;
+    }
+    if (_uc_hook_page_overlap(uc->hook[UC_HOOK_MEM_WRITE_IDX].head, page, hi)) {
+        flags |= BP_MEM_WRITE;
+    }
+    return flags;
+}
+
 static inline bool uc_mem_hook_installed(struct uc_struct *uc, hwaddr paddr)
 {
     if (HOOK_EXISTS_BOUNDED(uc, UC_HOOK_MEM_FETCH_UNMAPPED, paddr))

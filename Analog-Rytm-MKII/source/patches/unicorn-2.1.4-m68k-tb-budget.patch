+/* tb-budget: count blocks inline instead of with a UC_HOOK_BLOCK. `state`
+   points at {int64_t left; int64_t blocks;}: at every block start, if
+   left <= 0 the run is stopped (uc_emu_stop, honoured by the block-start exit
+   check right after, so that block does not run), else left -= 1 and
+   blocks += 1 -- what a block hook doing the same did. NULL turns it off. */
+UNICORN_EXPORT
+uc_err uc_set_block_budget(uc_engine *uc, int64_t *state)
+{
+    UC_INIT(uc);
+    uc->block_budget = state;
+    uc->tb_flush(uc);
+    restore_jit_state(uc);
+    return UC_ERR_OK;
+}
+
 UNICORN_EXPORT
 uc_err uc_emu_stop(uc_engine *uc)
 {

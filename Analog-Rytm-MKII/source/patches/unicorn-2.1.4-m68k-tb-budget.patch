diff --git a/qemu/accel/tcg/translator.c b/qemu/accel/tcg/translator.c
index 72f21c4..cdbfffd 100644
--- a/qemu/accel/tcg/translator.c
+++ b/qemu/accel/tcg/translator.c
@@ -82,6 +82,41 @@ void translator_loop(const TranslatorOps *ops, DisasContextBase *db,
 
     // tcg_dump_ops(tcg_ctx, false, "translator loop");
 
+    /* tb-budget (uc_set_block_budget): what a block hook counting blocks did,
+       inline: left <= 0 -> stop (caught by the exit check just below), else
+       left -= 1, blocks += 1. */
+    if (uc->block_budget) {
+        TCGLabel *stop = gen_new_label(tcg_ctx);
+        /* a stop here resumes at this block: its PC must be in env, as the
+           block hook's pc_sync made sure */
+        if (!block_hook) {
+            ops->pc_sync(db, cpu);
+        }
+        TCGLabel *done = gen_new_label(tcg_ctx);
+        TCGv_ptr bp = tcg_const_ptr(tcg_ctx, uc->block_budget);
+        TCGv_i64 v = tcg_temp_new_i64(tcg_ctx);
+        tcg_gen_ld_i64(tcg_ctx, v, bp, 0);
+        tcg_gen_brcondi_i64(tcg_ctx, TCG_COND_LE, v, 0, stop);
+        tcg_temp_free_i64(tcg_ctx, v);
+        tcg_temp_free_ptr(tcg_ctx, bp);
+        bp = tcg_const_ptr(tcg_ctx, uc->block_budget);
+        v = tcg_temp_new_i64(tcg_ctx);
+        tcg_gen_ld_i64(tcg_ctx, v, bp, 0);
+        tcg_gen_subi_i64(tcg_ctx, v, v, 1);
+        tcg_gen_st_i64(tcg_ctx, v, bp, 0);
+        tcg_gen_ld_i64(tcg_ctx, v, bp, 8);
+        tcg_gen_addi_i64(tcg_ctx, v, v, 1);
+        tcg_gen_st_i64(tcg_ctx, v, bp, 8);
+        tcg_temp_free_i64(tcg_ctx, v);
+        tcg_temp_free_ptr(tcg_ctx, bp);
+        tcg_gen_br(tcg_ctx, done);
+        gen_set_label(tcg_ctx, stop);
+        bp = tcg_const_ptr(tcg_ctx, uc);
+        gen_helper_uc_budget_stop(tcg_ctx, bp);
+        tcg_temp_free_ptr(tcg_ctx, bp);
+        gen_set_label(tcg_ctx, done);
+    }
+
     /* Start translating.  */
     gen_tb_start(tcg_ctx, db->tb);
     // tcg_dump_ops(tcg_ctx, false, "tb start");

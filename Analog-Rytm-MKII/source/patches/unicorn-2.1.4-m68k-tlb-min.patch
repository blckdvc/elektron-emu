From 811e8e9de31ad1b32aea087c10bad4ab4c9e1cba Mon Sep 17 00:00:00 2001
From: simo <simoof>
Date: Mon, 28 Sep 2026 13:30:11 +0200
Subject: [PATCH] tlbmin

---
 qemu/include/exec/cpu-defs.h | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/qemu/include/exec/cpu-defs.h b/qemu/include/exec/cpu-defs.h
index 5c11015..ea5fc17 100644
--- a/qemu/include/exec/cpu-defs.h
+++ b/qemu/include/exec/cpu-defs.h
@@ -82,8 +82,16 @@ typedef uint64_t target_ulong;
 #define CPU_TLB_ENTRY_BITS 6
 #endif
 
-#define CPU_TLB_DYN_MIN_BITS 6
-#define CPU_TLB_DYN_DEFAULT_BITS 8
+/*
+ * Unicorn (tlb-min): the TLB is resized only when it is flushed, and the one
+ * flush of a CPU reset happens with an empty usage window, which shrinks it to
+ * the minimum. An emulator that never flushes afterwards then runs its whole
+ * life on 64 direct-mapped entries: guest code, SRAM and I/O pages whose page
+ * numbers share their low bits keep evicting each other (measured on a
+ * ColdFire firmware: ~128k refills per emulated second, 220 with 4096).
+ */
+#define CPU_TLB_DYN_MIN_BITS 12
+#define CPU_TLB_DYN_DEFAULT_BITS 12
 
 # if HOST_LONG_BITS == 32
 /* Make sure we do not require a double-word shift for the TLB load */
-- 

index f1110b4..228d84d 100644
--- a/qemu/accel/tcg/cpu-exec-common.c
+++ b/qemu/accel/tcg/cpu-exec-common.c
@@ -36,10 +36,7 @@ void cpu_reloading_memory_map(void)
 
 void cpu_loop_exit(CPUState *cpu)
 {
-    /* Unlock JIT write protect if applicable. */
-    if (cpu->uc->nested_level == 1) {
-        tb_exec_unlock(cpu->uc);
-    }
+    /* Unicorn (jit-toggle): leave the JIT executable, see cpu_tb_exec. */

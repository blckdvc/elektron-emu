diff --git a/qemu/accel/tcg/cpu-exec.c b/qemu/accel/tcg/cpu-exec.c
index 77168f3..8982dc6 100644
--- a/qemu/accel/tcg/cpu-exec.c
+++ b/qemu/accel/tcg/cpu-exec.c
@@ -58,10 +58,11 @@ static inline tcg_target_ulong cpu_tb_exec(CPUState *cpu, TranslationBlock *itb)
     UC_TRACE_START(UC_TRACE_TB_EXEC);
     tb_exec_lock(cpu->uc);
     ret = tcg_qemu_tb_exec(env, tb_ptr);
-    if (cpu->uc->nested_level == 1) {
-        // Only unlock (allow writing to JIT area) if we are the outmost uc_emu_start
-        tb_exec_unlock(cpu->uc);
-    }
+    // Unicorn (jit-toggle): the JIT stays executable between blocks. Every
+    // path that writes it (tb_gen_code, tb_add_jump, tb_phys_invalidate,
+    // tb_flush) unlocks it itself, and restore_jit_state puts the thread's
+    // entry state back when uc_emu_start returns. Unlocking here cost two
+    // pthread_jit_write_protect_np per exit from generated code.
     UC_TRACE_END(UC_TRACE_TB_EXEC, "[uc] exec tb 0x%" PRIx64 ": ", itb->pc);
 
     cpu->can_do_io = 1;

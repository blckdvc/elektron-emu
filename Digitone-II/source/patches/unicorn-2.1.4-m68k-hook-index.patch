+    // hook-index patch: per-address cache of the UC_HOOK_CODE hooks whose bounds
+    // contain that address, in list order. helper_uc_tracecode used to walk the
+    // whole code-hook list on every hooked instruction; with many point hooks
+    // (idle loops, hot loops, tracers) that walk dominated. Filled on a miss,
+    // dropped as a whole by bumping code_hook_gen whenever a hook is added,
+    // deleted or purged. n == CODE_HOOK_CACHE_OVER means "too many, walk the list".
+#define CODE_HOOK_CACHE_SIZE 1024
+#define CODE_HOOK_CACHE_WAYS 6
+#define CODE_HOOK_CACHE_OVER 0xFFFF
+    uint32_t code_hook_gen;
+    struct uc_code_hook_cache {
+        uint64_t addr;
+        uint32_t gen;
+        uint16_t n;
+        struct hook *hooks[CODE_HOOK_CACHE_WAYS];
+    } code_hook_cache[CODE_HOOK_CACHE_SIZE];
+
     // hook to count number of instructions for uc_emu_start()
     uc_hook count_hook;
 

+/* Unicorn (hookmem-pages): does a live hook of list `idx` cover any byte of
+   the page at `page`? */
+static bool uc_hook_covers_page(struct uc_struct *uc, int idx, target_ulong page)
+{
+    struct list_item *cur;
+    uint64_t lo = page, hi = (uint64_t)page + TARGET_PAGE_SIZE - 1;
+
+    for (cur = uc->hook[idx].head; cur != NULL; cur = cur->next) {
+        struct hook *hk = (struct hook *)cur->data;
+        if (hk->to_delete) {
+            continue;
+        }
+        if (hk->begin > hk->end || (hk->begin <= hi && hk->end >= lo)) {
+            return true;
+        }
+    }
+    return false;
+}

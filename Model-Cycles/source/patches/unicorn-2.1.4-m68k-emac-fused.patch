diff --git a/qemu/target/m68k/helper.c b/qemu/target/m68k/helper.c
index bd166cb..4f69cb0 100644
--- a/qemu/target/m68k/helper.c
+++ b/qemu/target/m68k/helper.c
@@ -776,6 +776,55 @@ void HELPER(mac_set_flags)(CPUM68KState *env, uint32_t acc)
     }
 }
 
+/*
+ * Unicorn (emac-fused): one MAC or MSAC without dual accumulate in a single
+ * call -- the multiply (macmulf/macmuls/macmulu), the scale factor, the add or
+ * subtract into the accumulator, the saturation and mac_set_flags, exactly the
+ * sequence DISAS_INSN(mac) used to emit as three helper calls and TCG ops.
+ * desc: bits 1..0 acc, 3..2 scale factor (ext bits 10..9), 4 MSAC,
+ * 6..5 mode (0 fractional, 1 signed, 2 unsigned), 7 MACSR.SU -- the mode bits
+ * are the translation-time MACSR, as before.
+ */
+void HELPER(mac_fused)(CPUM68KState *env, uint32_t rx, uint32_t ry, uint32_t desc)
+{
+    int acc = desc & 3;
+    int mode = (desc >> 5) & 3;
+    uint64_t prod;
+
+    if (mode == 0) {
+        prod = HELPER(macmulf)(env, rx, ry);
+    } else if (mode == 1) {
+        prod = HELPER(macmuls)(env, rx, ry);
+    } else {
+        prod = HELPER(macmulu)(env, rx, ry);
+    }
+    switch ((desc >> 2) & 3) {
+    case 1:
+        prod <<= 1;
+        break;
+    case 3:
+        if (desc & 0x80) {
+            prod >>= 1;
+        } else {
+            prod = (uint64_t)((int64_t)prod >> 1);
+        }
+        break;
+    }
+    if (desc & 0x10) {
+        env->macc[acc] -= prod;
+    } else {
+        env->macc[acc] += prod;
+    }
+    if (mode == 0) {
+        HELPER(macsatf)(env, acc);
+    } else if (mode == 1) {
+        HELPER(macsats)(env, acc);
+    } else {
+        HELPER(macsatu)(env, acc);
+    }
+    HELPER(mac_set_flags)(env, acc);
+}
+
 #define EXTSIGN(val, index) (     \
     (index == 0) ? (int8_t)(val) : ((index == 1) ? (int16_t)(val) : (val)) \
 )

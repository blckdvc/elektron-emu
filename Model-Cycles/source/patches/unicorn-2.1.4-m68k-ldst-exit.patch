+++ b/qemu/accel/tcg/cputlb.c
@@ -1912,6 +1912,33 @@ _out:
  * We don't bother with this widened value for SOFTMMU_CODE_ACCESS.
  */
 
+/*
+ * Unicorn (ldst-exit): the exit-request check that used to follow every TCG
+ * load and store (check_exit_request after each qemu_ld/qemu_st). Only hooks
+ * and MMIO callbacks, which run on this slow path, can request an exit in the
+ * middle of a block, so the check lives here: same test, same state restore
+ * (the access completes first, the instruction is restored as before).
+ * Skipped inside the split halves of an unaligned access (size_recur_mem).
+ */
+static inline void uc_ldst_exit_check(CPUArchState *env, uintptr_t retaddr)
+{
+    struct uc_struct *uc = env->uc;
+
+    if (uc->size_recur_mem || !cpu_loop_exit_requested(uc->cpu)) {
+        return;
+    }
+    if (uc->nested_level == 1) {
+        tb_exec_unlock(uc);
+    }
+    uc->cpu->tcg_exit_req = 0;
+    if (uc->skip_sync_pc_on_exit) {
+        uc->skip_sync_pc_on_exit = false;
+        cpu_loop_exit(uc->cpu);
+    } else {
+        cpu_loop_exit_restore(uc->cpu, retaddr);
+    }
+}
+

@@ -5701,8 +5701,36 @@ static void gen_mac_clear_flags(TCGContext *tcg_ctx)
  * macsatf with OMC read at run time, mac_set_flags for FI), with no helper
  * call. FI/SU are the translation-time MACSR, as for the helpers.
  */
+static void disas_mac(CPUM68KState *env, DisasContext *s, uint16_t insn);
+static void disas_to_mac(CPUM68KState *env, DisasContext *s, uint16_t insn);
+
+/*
+ * emac-spec: is the next instruction, in this same TB, one that clears and
+ * recomputes MACSR N, Z, V and EV (mac/msac, move.l <ea>,ACCx)?  Then this
+ * one's are dead and need not be computed; the sticky PAV bits still are.
+ * Only when nothing can observe the state in between: the next instruction
+ * is on this page, the TB will not end here (length, op buffer, page end),
+ * it is not an exit address and no code hook covers it.
+ */
+static bool emac_next_sets_flags(CPUM68KState *env, DisasContext *s)
+{
+    struct uc_struct *uc = s->uc;
+    target_ulong next = s->pc;
+    disas_proc f;
+
+    if (s->base.num_insns >= s->base.max_insns ||
+        uc->tcg_ctx->nb_ops >= 4000 - 256 ||
+        next - (s->base.pc_first & TARGET_PAGE_MASK) >= TARGET_PAGE_SIZE - 32 ||
+        uc_addr_is_exit(uc, next) ||
+        HOOK_EXISTS_BOUNDED(uc, UC_HOOK_CODE, next)) {
+        return false;
+    }
+    f = (disas_proc)env->opcode_table[cpu_lduw_code(env, next)];
+    return f == disas_mac || f == disas_to_mac;
+}

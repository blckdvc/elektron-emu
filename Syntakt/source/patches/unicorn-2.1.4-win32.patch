+     * %xmm0,0x889d0(%rbx). glibc/macOS allocators give 16 anyway, and MSVC
+     * does not emit movaps there, which is why only mingw on real Windows failed.
+     */
+    if (alignment < 16) {
+        alignment = 16;
+    }

diff --git a/qemu/target/m68k/helper.c b/qemu/target/m68k/helper.c
index 98463eb..bd166cb 100644
--- a/qemu/target/m68k/helper.c
+++ b/qemu/target/m68k/helper.c
@@ -180,7 +180,7 @@ void HELPER(set_macsr)(CPUM68KState *env, uint32_t val)
             if (env->macsr & MACSR_FI) {
                 regval = (((uint64_t)acc) << 8) | extlow;
                 regval |= ((int64_t)exthigh) << 40;
-            } else if (env->macsr & MACSR_SU) {
+            } else if (!(env->macsr & MACSR_SU)) {
                 regval = acc | (((int64_t)extlow) << 32);
                 regval |= ((int64_t)exthigh) << 40;
             } else {
@@ -629,7 +629,8 @@ uint64_t HELPER(macmuls)(CPUM68KState *env, uint32_t op1, uint32_t op2)
     int64_t product;
     int64_t res;
 
-    product = (uint64_t)op1 * op2;
+    /* Signed operands (CFPRM 6.2): the product of two int32 values.  */
+    product = (int64_t)(int32_t)op1 * (int32_t)op2;
     res = (product << 24) >> 24;
     if (res != product) {
         env->macsr |= MACSR_V;
@@ -663,19 +664,24 @@ uint64_t HELPER(macmulu)(CPUM68KState *env, uint32_t op1, uint32_t op2)
 
 uint64_t HELPER(macmulf)(CPUM68KState *env, uint32_t op1, uint32_t op2)
 {
-    uint64_t product;
+    int64_t product;
     uint32_t remainder;
 
-    product = (uint64_t)op1 * op2;
+    /*
+     * Fractional operands are signed Q31 (CFPRM 6.2): the Q62 product is
+     * aligned to the accumulator, which this file keeps as Q39 (ACC << 8
+     * plus 8 extension bits each side), so the shift is 62 - 39 = 23.
+     */
+    product = (int64_t)(int32_t)op1 * (int32_t)op2;
     if (env->macsr & MACSR_RT) {
-        remainder = product & 0xffffff;
-        product >>= 24;
-        if (remainder > 0x800000)
+        remainder = product & 0x7fffff;
+        product >>= 23;
+        if (remainder > 0x400000)
             product++;
-        else if (remainder == 0x800000)
+        else if (remainder == 0x400000)
             product += (product & 1);
     } else {
-        product >>= 24;
+        product >>= 23;
     }
     return product;
 }
@@ -760,7 +766,7 @@ void HELPER(mac_set_flags)(CPUM68KState *env, uint32_t acc)
         val = ((int64_t)val) >> 40;
         if (val != 0 && val != -1)
             env->macsr |= MACSR_EV;
-    } else if (env->macsr & MACSR_SU) {
+    } else if (!(env->macsr & MACSR_SU)) {
         val = ((int64_t)val) >> 32;
         if (val != 0 && val != -1)
             env->macsr |= MACSR_EV;
@@ -883,14 +889,14 @@ uint32_t HELPER(get_macf)(CPUM68KState *env, uint64_t val)
     } else if (env->macsr & MACSR_RT) {
         /* 32-bit rounding.  */
         rem = val & 0xff;
-        val >>= 8;
+        val = (uint64_t)((int64_t)val >> 8);
         if (rem > 0x80)
             val++;
         else if (rem == 0x80)
             val += (val & 1);
     } else {
         /* No rounding.  */
-        val >>= 8;
+        val = (uint64_t)((int64_t)val >> 8);
     }
     if (env->macsr & MACSR_OMC) {
         /* Saturate.  */
@@ -901,8 +907,8 @@ uint32_t HELPER(get_macf)(CPUM68KState *env, uint64_t val)
                 result = val & 0xffff;
             }
         } else {
-            if (val != (uint32_t)val) {
-                result = ((uint32_t)(val >> 63) & 0x7fffffff);
+            if ((int64_t)val != (int32_t)val) {
+                result = ((int64_t)val < 0) ? 0x80000000u : 0x7fffffffu;
             } else {
                 result = (uint32_t)val;
             }
